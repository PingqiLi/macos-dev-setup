{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.2",
  "plugin": [
    "oh-my-opencode@latest"
  ],
  "provider": {
    "openrouter": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenRouter",
      "options": {
        "baseURL": "https://openrouter.ai/api/v1",
        "apiKey": "{env:OPENROUTER_API_KEY}"
      },
      "models": {
        "qwen/qwen3.5-plus": {
          "name": "Qwen 3.5 Plus",
          "limit": {
            "context": 256000,
            "output": 65536
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        },
        "minimax/minimax-m2-5": {
          "name": "MiniMax M2.5",
          "limit": {
            "context": 205000,
            "output": 65536
          }
        },
        "z-ai/glm-5": {
          "name": "GLM-5",
          "limit": {
            "context": 200000,
            "output": 65536
          }
        }
      }
    }
  }
}
