# See: https://ghostty.org/docs/config/reference
# WARN: don't use inline comments beside keybinds! They break the parsing and outputting weird text.

############
# BEHAVIOR #
############

clipboard-paste-protection = false
confirm-close-surface = false
window-inherit-working-directory = true

######
# UI #
######

# Colors
# see: ghostty +list-themes
theme = Catppuccin Mocha
background = 181825
# background = 12121C
# theme = aura
# theme = nord
# background = 1a1e23
cursor-invert-fg-bg = true

# Typography
font-family = JetBrainsMono Nerd Font
font-size = 13.5
adjust-cell-height = 35%

# Window
# macos-titlebar-style = hidden
# macOS-friendly maximize: `maximize = true` is bugged on macOS
# (https://github.com/ghostty-org/ghostty/discussions/5881) and the
# window-width/height workaround respects Stage Manager's reserved area.
# Instead, persist whatever window frame you set up — manually zoom
# (option-click the green button) once, and Ghostty restores it forever.
window-save-state = always
window-decoration = true
window-padding-x = 8
window-padding-y = 8
window-padding-balance = true

############
# KEYBINDS #
############

# See: https://ghostty.org/docs/config/reference#keybind
# Possible trigger key syntax: https://github.com/ghostty-org/ghostty/blob/d6e76858164d52cff460fedc61ddf2e560912d71/src/input/key.zig#L246

# Font
keybind = cmd+shift+plus=increase_font_size:1
keybind = cmd+shift+minus=decrease_font_size:1
keybind = cmd+shift+r=reload_config

# Tabs
keybind = cmd+t=new_tab
keybind = cmd+w=close_surface
keybind = cmd+right_bracket=next_tab
keybind = cmd+left_bracket=previous_tab
# re "physical", see: https://github.com/ghostty-org/ghostty/issues/817
keybind = cmd+physical:one=goto_tab:1
keybind = cmd+physical:two=goto_tab:2
keybind = cmd+physical:three=goto_tab:3
keybind = cmd+physical:four=goto_tab:4
keybind = cmd+physical:five=goto_tab:5
keybind = cmd+physical:six=goto_tab:6
keybind = cmd+physical:seven=goto_tab:7
keybind = cmd+physical:eight=goto_tab:8
keybind = cmd+physical:nine=goto_tab:9

# Splits
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+shift+h=goto_split:left
keybind = cmd+shift+j=goto_split:down
keybind = cmd+shift+k=goto_split:up
keybind = cmd+shift+l=goto_split:right
keybind = cmd+shift+m=toggle_split_zoom

# See: https://github.com/badlogic/pi-mono/blob/main/packages/coding-agent/docs/terminal-setup.md#ghostty
keybind = alt+backspace=text:\x1b\x7f

# Support Claude Code shift+enter
keybind = shift+enter=text:\n
